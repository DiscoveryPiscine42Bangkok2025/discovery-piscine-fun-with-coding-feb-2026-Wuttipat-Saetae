CSS


body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
}

.menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.menu > ul > li {
    background-color: #2c3e50;
    color: white;
    padding: 15px 30px;
    width: 200px;
    cursor: pointer;
    position: relative;
    border-radius: 8px 8px 0 0; /* เพิ่ม */
}

.dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #34495e;
    width: 200px;
    border-radius: 0 0 8px 8px; /* เพิ่ม */
}

.dropdown li {
    padding: 12px;
    border-top: 1px solid #2c3e50;
}

.dropdown li:hover {
    background-color: #1abc9c;
}

.menu li:hover .dropdown {
    display: block;
}
