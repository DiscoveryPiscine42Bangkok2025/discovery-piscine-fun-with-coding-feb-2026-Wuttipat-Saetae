<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Tab</title>

    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            border: 1px solid black;
            padding: 40px;
            font-size: 20px;
        }

        .first {
            background-color: #c9cf8a;
        }

        .second {
            background-color: #f8c9b5;
        }
    </style>
</head>
<body>

    <table>
        <tr>
            <td class="first">First cell</td>
            <td class="second">Second cell</td>
        </tr>
    </table>

</body>
</html>
