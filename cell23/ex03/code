<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User profile card</title>
    <link rel="stylesheet" href="card.css">
</head>
<body>

<div class="card">
    <h1>My Profile</h1>

    <table>
        <tr>
            <td colspan="2" class="center">
                <img src="catme.jpg" alt="profile" class="profile">
            </td>
        </tr>

        <tr>
            <td colspan="2" class="center login">
                wsaetae 20
            </td>
        </tr>

        <tr>
            <td colspan="2" class="center desc">
                Beginner Pivot Animator
            </td>
        </tr>

        <tr>
            <td class="center">
                <img src="fb.png" class="social">
            </td>
            <td class="center">
                <img src="twitter.png" class="social">
            </td>
        </tr>

        <tr>
            <td colspan="2" class="center">
                <button>Contact</button>
            </td>
        </tr>
    </table>
</div>

</body>
</html>






  

  CSS


  body {
    background-color: #f2f2f2;
    font-family: Arial, sans-serif;
}

.card {
    width: 320px;
    margin: 50px auto;
    background: white;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
}

table {
    width: 100%;
    border-collapse: collapse;
}

td {
    padding: 8px;
}

.center {
    text-align: center;
}

.profile {
    width: 120px;
    border-radius: 50%;
}

.login {
    font-weight: bold;
    font-size: 18px;
}

.desc {
    color: gray;
    font-size: 14px;
}

.social {
    width: 32px;
    height: 32px;
    object-fit: contain;
    background: white;
    padding: 4px;
}

button {
    margin-top: 10px;
    padding: 8px 20px;
    border: none;
    background: black;
    color: white;
    cursor: pointer;
}
