<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Responsive</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        table.main {
            width: 100vw;
            height: 100vh;
            border-collapse: collapse;
        }

        table.main td {
            border: 1px solid black;
            padding: 2vw;
            text-align: center;
            vertical-align: middle;
        }

        .title {
            font-size: 4vw;
        }

        .images {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 4vw;
            flex-wrap: wrap;
        }

        .images img {
            width: 20vw;
            min-width: 150px;
        }

        .basics {
            background-color: pink;
            padding: 4vh 0;
        }

        .basics h1 {
            color: white;
            font-size: 4vw;
            margin-bottom: 4vh;
        }

        .shops {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6vw;
        }

        .shop {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .shop img {
            width: 200px;
            height: 120px;
            object-fit: contain;
        }

        .footer {
            text-align: right;
            font-style: italic;
            font-family: monospace;
            margin-top: 4vh;
            padding-right: 2vw;
        }

        .inner-table {
            width: 100%;
            height: 100%;
            border-collapse: collapse;
        }

        .inner-table td {
            border: 1px solid black;
            font-size: 2vw;
        }

        .first {
            background-color: #c9cf8a;
        }

        .second {
            background-color: #f8c9b5;
        }
    </style>
</head>

<body>

<table class="main">
    <tr>
        <td>
            <div class="title">Piscine Web</div>
        </td>
    </tr>

    <tr>
        <td>
            <div class="images">
                <div>
                    <p style="visibility:hidden;">.</p>
                    <a href="https://www.youtube.com/watch?v=INscMGmhmX4">
                        <img src="catlook.jpg" alt="Cat">
                    </a>
                </div>

                <div>
                    <p>I want to sleep!!!</p>
                    <img src="catsit.jpg" alt="Cat sit">
                </div>
            </div>
        </td>
    </tr>

    <tr>
        <td class="basics">
            <h1>Welcome to Basics!</h1>

            <div class="shops">
                <div class="shop">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg" alt="Amazon">
                    <a href="https://www.amazon.com">Amazon</a>
                </div>

                <div class="shop">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/0/0e/Shopee_logo.svg" alt="Shopee">
                    <a href="https://shopee.com">Shopee</a>
                </div>
            </div>

            <div class="footer">© yourlogin 2026</div>
        </td>
    </tr>

    <tr>
        <td>
            <table class="inner-table">
                <tr>
                    <td class="first">First cell</td>
                    <td class="second">Second cell</td>
                </tr>
            </table>
        </td>
    </tr>
</table>

</body>
</html>
